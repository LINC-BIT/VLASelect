<?xml version="1.0" ?>
<robot name="mycobot_pro_630">

  <!-- ===================== -->
  <!-- Groups -->
  <!-- ===================== -->

  <!-- Arm group -->
  <group name="mycobot_arm">
    <joint name="joint1_to_base"/>
    <joint name="joint2_to_joint1"/>
    <joint name="joint3_to_joint2"/>
    <joint name="joint4_to_joint3"/>
    <joint name="joint5_to_joint4"/>
    <joint name="joint6_to_joint5"/>
  </group>

  <!-- Gripper group -->
  <group name="gripper">
    <link name="gripper_base"/>
    <link name="gripper_left1"/>
    <link name="gripper_left2"/>
    <link name="gripper_left3"/>
    <link name="gripper_right1"/>
    <link name="gripper_right2"/>
    <link name="gripper_right3"/>
  </group>

  <!-- ===================== -->
  <!-- Group States -->
  <!-- ===================== -->

  <group_state name="home" group="mycobot_arm">
    <joint name="joint1_to_base" value="0"/>
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="0"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="0"/>
    <joint name="joint6_to_joint5" value="0"/>
  </group_state>

  <!-- ===================== -->
  <!-- End Effector -->
  <!-- ===================== -->

  <end_effector
      name="gripper_eef"
      parent_link="gripper_base"
      group="gripper"/>

  <!-- ===================== -->
  <!-- Virtual Joint -->
  <!-- ===================== -->

  <virtual_joint
      name="virtual_joint"
      type="fixed"
      parent_frame="world"
      child_link="base"/>

  <!-- ===================== -->
  <!-- Disable Collisions -->
  <!-- ===================== -->

  <!-- Gripper internal collisions -->
  <disable_collisions link1="gripper_base" link2="gripper_left1" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_left2" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_left3" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_right1" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_right3" reason="Default"/>

  <disable_collisions link1="gripper_left1" link2="gripper_left2" reason="Default"/>
  <disable_collisions link1="gripper_left1" link2="gripper_left3" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="gripper_left3" reason="Default"/>

  <disable_collisions link1="gripper_right1" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_right1" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_right2" link2="gripper_right3" reason="Default"/>

  <!-- Left / Right fingers -->
  <disable_collisions link1="gripper_left1" link2="gripper_right1" reason="Default"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right1" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right1" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right3" reason="Default"/>

  <!-- Wrist to gripper -->
  <disable_collisions link1="gripper_base" link2="joint6" reason="Default"/>

</robot>
